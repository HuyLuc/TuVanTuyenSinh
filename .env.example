# Sao chép thành .env và điền giá trị. KHÔNG commit file .env.

# Lấy tại https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Tên mô hình: kiểm tra bản mới nhất bằng `uv run python scripts/smoke_test.py --list-models`
GEMINI_MODEL_ANSWER=gemini-2.5-flash
GEMINI_MODEL_ROUTER=gemini-2.5-flash-lite

# Cache kết quả gọi LLM (tắt khi cần đo độ trễ thật)
LLM_CACHE_ENABLED=true

# Lưu log câu hỏi: "local" (file JSONL trong data/logs) hoặc "hf_dataset"
QUERY_LOG_BACKEND=local
# Chỉ dùng khi QUERY_LOG_BACKEND=hf_dataset (Dataset nên để riêng tư)
HF_LOG_REPO_ID=
HF_TOKEN=
